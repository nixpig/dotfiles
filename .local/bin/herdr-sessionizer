#!/usr/bin/env bash

directory="$(find ~ ~/projects ~/.config ~/.local ~/work -mindepth 0 -maxdepth 1 -type d 2>/dev/null | fzf)"

if [[ -z "$directory" ]]; then
	# echo "No directory selected"
	exit 0
fi

workspace_label="$(basename "$directory" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr '.' '_')"

if [[ -z "$workspace_label" ]]; then
	echo "Could not create valid workspace label from selected directory '$directory'"
	exit 1
fi

status="$(herdr status server --json | jq -r '.status')"

if [ "$status" != "not_running" ]; then
	# Reuse an existing workspace with the same label instead of duplicating it
	existing_id="$(herdr workspace list 2>/dev/null |
		jq -r --arg label "$workspace_label" \
			'.result.workspaces[]? | select(.label == $label) | .workspace_id' |
		head -n 1)"

	if [[ -n "$existing_id" ]]; then
		herdr workspace focus "$existing_id"
		exit $?
	fi

	herdr workspace create --cwd "$directory" --label "$workspace_label" --focus
else
	herdr
fi

