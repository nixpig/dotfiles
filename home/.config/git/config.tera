# Rendered by `mise dot apply` to ~/.config/git/config. Git reads this as well as
# ~/.gitconfig, which holds everything that's the same on every machine.
# The work identity applies on machines with the `work` mise environment (see README).
{% if mise_env is defined and "work" in mise_env -%}
[user]
	name = Jake Ward
	email = jacob.ward@goteleport.com
{%- else -%}
[user]
	email = 143995476+nixpig@users.noreply.github.com
	name = nixpig
{%- endif %}
{%- if os() == "macos" %}
[credential]
	helper = osxkeychain
{%- endif %}
