provider_installation {
{%- if mise_env is defined and "work" in mise_env %}
  # Work: use local builds of the Teleport provider.
  dev_overrides {
    "terraform.releases.teleport.dev/gravitational/teleport" = "{{ env.HOME }}/projects/teleport/integrations/terraform/build"
  }
{%- endif %}
  direct {}
}
