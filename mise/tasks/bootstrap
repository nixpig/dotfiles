#!/usr/bin/env bash
#MISE description="Setup that mise can't declare: run last by `mise bootstrap`"
#
# Each step checks whether it's already done, so this is safe to run again
# (`mise run bootstrap`, or `mise run bootstrap -- <step>...` for particular steps).
# A failed step doesn't stop the others; the summary lists what failed and what's
# left to do by hand, and the task exits non-zero if anything failed.

set -uo pipefail

HERDR_PLUGINS="aimdevlee/herdr-nvim-nav makyinmars/herdr-context.nvim jeffarese/herdr-bar persiyanov/herdr-reviewr"
HERDR_PLUGINS_MACOS="assawalhy/herdr-stay-awake"
OPERATOR_MONO_REPO="nixpig/operator-mono-powerline-ligatures"

case "$(uname -s)" in Darwin) OS=macos ;; *) OS=linux ;; esac

skip() { echo "already done: $*"; exit 99; }
manual() { echo "$*"; exit 98; }

# ---------------------------------------------------------------- steps ---

step_rustup() {
  # Not a mise tool: mise's rust sets RUSTUP_TOOLCHAIN everywhere, which overrides a
  # project's rust-toolchain.toml (its pinned version and targets).
  [ -x "$HOME/.cargo/bin/rustup" ] && skip "rustup"
  curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path
}

step_rustup_components() {
  # rust-analyzer: Neovim's Rust LSP (rustaceanvim). rust-src: its std completion.
  # ~/.cargo/bin/rust-analyzer is always there as a rustup proxy, so check the components.
  local rustup="$HOME/.cargo/bin/rustup" have missing="" c
  have=$("$rustup" component list --installed)
  for c in rust-analyzer rust-src; do
    grep -q "^$c" <<<"$have" || missing="$missing $c"
  done
  [ -n "$missing" ] || skip "rustup components"
  # shellcheck disable=SC2086
  "$rustup" component add $missing
}

step_blesh() {
  [ -f "$HOME/.local/share/blesh/ble.sh" ] && skip "ble.sh"
  # Cloned by [bootstrap.repos]; builds into its own (git-ignored) out/ directory.
  make -C "$HOME/.local/src/ble.sh" install PREFIX="$HOME/.local"
}

step_herdr_plugins() {
  local list="$HERDR_PLUGINS" installed todo="" p
  [ "$OS" = macos ] && list="$list $HERDR_PLUGINS_MACOS"
  installed=$(herdr plugin list 2>/dev/null || true)
  for p in $list; do
    case "$installed" in *"github:$p@"*) ;; *) todo="$todo $p" ;; esac
  done
  [ -n "$todo" ] || skip "herdr plugins"
  # --yes: herdr refuses remote installs without it when stdin isn't a terminal.
  for p in $todo; do herdr plugin install --yes "$p"; done
}

step_bat_cache() {
  # Compiles the Catppuccin theme in ~/.config/bat/themes into bat's cache.
  bat cache --build
}

step_docker_group() {
  case " $(id -nG) " in *" docker "*) skip "docker group" ;; esac
  sudo usermod -aG docker "$USER"
  manual "Run 'newgrp docker' to use docker in this terminal now; log out and back in for every other terminal and tmux (check: docker run --rm hello-world)."
}

step_operator_mono() {
  compgen -G "$HOME/Library/Fonts/*[Oo]perator*" >/dev/null && skip "Operator Mono"
  # Checks access, not just sign-in: CI's token is signed in but can't see the private repo.
  gh repo view "$OPERATOR_MONO_REPO" >/dev/null 2>&1 ||
    manual "Run 'gh auth login' (as an account that can see $OPERATOR_MONO_REPO), then 'mise run bootstrap -- operator-mono'."
  local tmp
  tmp=$(mktemp -d)
  gh repo clone "$OPERATOR_MONO_REPO" "$tmp/fonts" -- --depth 1
  find "$tmp/fonts" -type f \( -iname '*.otf' -o -iname '*.ttf' \) -exec cp {} "$HOME/Library/Fonts/" \;
  rm -rf "$tmp"
}

step_instant_space_switcher() {
  # What its Homebrew cask (jurplel/tap) does: copy the app from the release's .dmg.
  local app=/Applications/InstantSpaceSwitcher.app tmp url
  [ -d "$app" ] && skip "InstantSpaceSwitcher"
  # The latest release's version, from where /releases/latest redirects (.../tag/v3.1).
  # Not the GitHub API, whose rate limit CI runners often hit.
  url=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/jurplel/InstantSpaceSwitcher/releases/latest)
  local v=${url##*/v}
  url="https://github.com/jurplel/InstantSpaceSwitcher/releases/download/v$v/InstantSpaceSwitcher-$v.dmg"
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/app.dmg" "$url"
  hdiutil attach -nobrowse -readonly -mountpoint "$tmp/mnt" "$tmp/app.dmg" >/dev/null
  cp -R "$tmp/mnt/InstantSpaceSwitcher.app" /Applications/ || { hdiutil detach "$tmp/mnt" >/dev/null; return 1; }
  hdiutil detach "$tmp/mnt" >/dev/null
  rm -rf "$tmp"
}

step_logitune() {
  # Logitech only ships an interactive installer (the cask is `installer manual:` too).
  local dmg="$HOME/Downloads/LogiTuneInstaller.dmg"
  [ -d /Applications/LogiTune.app ] && skip "Logi Tune"
  [ -f "$dmg" ] || curl -fsSL -o "$dmg" https://software.vc.logitech.com/downloads/tune/LogiTuneInstaller.dmg
  manual "Install Logi Tune: open ~/Downloads/LogiTuneInstaller.dmg and run the installer."
}

step_mac_apps() {
  local marker="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/mac-apps-opened"
  [ -f "$marker" ] && skip "app permissions noted"
  mkdir -p "$(dirname "$marker")" && touch "$marker"
  manual "Open Docker Desktop, InstantSpaceSwitcher, UnnaturalScrollWheels and Logi Tune once and grant any permissions they ask for."
}

STEPS="rustup rustup-components blesh herdr-plugins bat-cache"
if [ "$OS" = macos ]; then STEPS="$STEPS operator-mono instant-space-switcher logitune mac-apps"; else STEPS="$STEPS docker-group"; fi

# --------------------------------------------------------------- runner ---

[ $# -gt 0 ] && STEPS="$*"

for name in $STEPS; do
  declare -F "step_${name//-/_}" >/dev/null || { echo "unknown step: $name (steps: $STEPS)" >&2; exit 2; }
done

results=() follow_ups=() failed=()
out=$(mktemp); trap 'rm -f "$out"' EXIT
for name in $STEPS; do
  echo "--- $name"
  # Run outside if/|| so set -e works inside the step.
  ( set -e; "step_${name//-/_}" ) 2>&1 | tee "$out"; rc=${PIPESTATUS[0]}
  case $rc in
    0)  results+=("ok      $name") ;;
    99) results+=("skip    $name") ;;
    98) results+=("manual  $name"); follow_ups+=("$(tail -n1 "$out")") ;;
    *)  results+=("FAIL    $name"); failed+=("$name") ;;
  esac
done

printf '\n--- bootstrap task summary\n'
printf '  %s\n' "${results[@]}"
if [ ${#follow_ups[@]} -gt 0 ]; then
  printf '\nTo do by hand:\n'
  printf '  - %s\n' "${follow_ups[@]}"
fi
if [ ${#failed[@]} -gt 0 ]; then
  printf '\nRetry with: mise run bootstrap -- %s\n' "${failed[*]}"
  exit 1
fi
